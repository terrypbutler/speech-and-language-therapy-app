# Copy this file to `.streamlit/secrets.toml` for local development.
# Add one or both keys. Never commit the real secrets file.
GEMINI_API_KEY = "replace-me"
OPENAI_API_KEY = "replace-me"

# Published fictional scenario library shared independently of the app code.
SCENARIO_LIBRARY_URL = "https://example.org/slt-scenario-library/library.json"

# Optional protected editor and publishing to the shared source library.
# Keep the password and token only in local or Streamlit Community Cloud secrets.
SCENARIO_EDITOR_PASSWORD = "choose-a-long-editor-password"
SCENARIO_GITHUB_REPOSITORY = "owner/slt-scenario-library"
SCENARIO_GITHUB_BRANCH = "main"
SCENARIO_GITHUB_DIRECTORY = "scenarios"
SCENARIO_GITHUB_TOKEN = "fine-grained-token-with-contents-write-access"
